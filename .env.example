# n8n reads these values; do not commit a real .env file.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-value
N8N_BASIC_AUTH_ACTIVE=false
FACTORY_REPOSITORY=OWNER/REPOSITORY
FACTORY_RUNNER_URL=http://host.docker.internal:8080

# Runner configuration (set in its shell/service, not necessarily Docker).
FACTORY_REPO_URL=https://github.com/OWNER/REPOSITORY.git
FACTORY_RUNS_DIR=../factory-runs
FACTORY_MAX_RUN_SECONDS=1800
